{
  "name": "officelens",
  "version": "0.2.0",
  "description": "Offline OOXML accessibility auditor for DOCX and PPTX. Deterministic JSON and CI exit codes, no JVM and no GUI.",
  "author": "svx",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "officelens": "src/cli.ts"
  },
  "files": [
    "src",
    "install.sh",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "private": true,
  "sideEffects": [
    "./src/cli.ts"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "make-fixtures": "bun run scripts/make-fixtures.ts",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "docx",
    "pptx",
    "ooxml",
    "office",
    "audit",
    "auditor",
    "sarif",
    "cli",
    "bun",
    "typescript",
    "headless",
    "ci"
  ],
  "homepage": "https://officelens-srivtx.vercel.app",
  "repository": "https://github.com/srivtx/officelens",
  "bugs": {
    "url": "https://github.com/srivtx/officelens/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "0.8.2"
  }
}
