{
  "name": "officelens",
  "version": "0.1.0",
  "description": "Offline OOXML accessibility auditor for DOCX and PPTX. Deterministic JSON and CI exit codes, no JVM and no GUI.",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "officelens": "src/cli.ts"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "make-fixtures": "bun run scripts/make-fixtures.ts",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "docx",
    "pptx",
    "ooxml",
    "office",
    "audit",
    "sarif",
    "cli"
  ],
  "homepage": "https://officelens-srivtx.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/srivtx/officelens.git"
  },
  "bugs": {
    "url": "https://github.com/srivtx/officelens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "0.8.2"
  },
  "license": "MIT"
}
